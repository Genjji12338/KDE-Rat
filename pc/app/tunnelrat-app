class SettingsPage(Adw.Bin):
    def __init__(self, win):
        super().__init__()
        self.win = win
        self.settings = None
        self.page = Adw.PreferencesPage()
        self.set_child(self.page)

        g = Adw.PreferencesGroup(title="Sharing")
        self.clip = Adw.SwitchRow(title="Clipboard sync", subtitle="One clipboard across this PC, your phone and joined PCs")
        self.mouse = Adw.SwitchRow(title="Shared mouse and keyboard", subtitle="Move the mouse over to joined PCs (Deskflow)")
        self.suspend = Adw.SwitchRow(title="Allow sleep", subtitle="Some graphics cards never wake up from it; test before relying on it")
        for r in (self.clip, self.mouse, self.suspend):
            g.add(r)
            r.connect("notify::active", lambda *_: self.save())
        self.page.add(g)

        self.leave = Adw.PreferencesGroup(
            title="Lock when I leave",
            description="Lock this PC when the phone has been gone for half a minute: out of Wi-Fi and Bluetooth range, or switched off.",
        )
        self.page.add(self.leave)
        self.leave_rows = []

        self.chips = Adw.PreferencesGroup(title="Top bar", description="Which devices show as a chip (with battery) in the top bar.")
        self.page.add(self.chips)
        self.chip_rows = []
        self.loading = False

    def refresh(self, devices):
        self.devices = devices
        call({"type": "get_settings"}, self.got, self.win.error)

    def got(self, replies):
        s = first(replies, "settings")
        if not s:
            return False
        s = s["settings"]
        self.loading = True
        self.settings = s
        self.clip.set_active(s.get("clipboard", True))
        self.mouse.set_active(s.get("shared_input", True))
        self.suspend.set_active(s.get("allow_suspend", False))
        for r in self.chip_rows:
            self.chips.remove(r)
        self.chip_rows = []
        hidden = set(s.get("hidden_chips", []))
        for d in self.devices:
            row = Adw.SwitchRow(title=GLib.markup_escape_text(d["name"]), subtitle="Phone" if d.get("kind") != "pc" else "PC", active=d["fingerprint"] not in hidden)
            row.fingerprint = d["fingerprint"]
            row.connect("notify::active", lambda *_: self.save())
            self.chips.add(row)
            self.chip_rows.append(row)
        if not self.devices:
            row = Adw.ActionRow(title="No paired devices")
            self.chips.add(row)
            self.chip_rows.append(row)
        for r in self.leave_rows:
            self.leave.remove(r)
        self.leave_rows = []
        gone = set(s.get("lock_when_gone", []))
        for d in self.devices:
            if d.get("kind") == "pc":
                continue
            row = Adw.SwitchRow(title=GLib.markup_escape_text(d["name"]), active=d["fingerprint"] in gone)
            row.fingerprint = d["fingerprint"]
            row.connect("notify::active", lambda *_: self.save())
            self.leave.add(row)
            self.leave_rows.append(row)
        if not self.leave_rows:
            row = Adw.ActionRow(title="No paired phones")
            self.leave.add(row)
            self.leave_rows.append(row)
        self.loading = False
        return False

    def save(self):
        if self.loading or self.settings is None:
            return
        s = dict(self.settings)
        s["clipboard"] = self.clip.get_active()
        s["shared_input"] = self.mouse.get_active()
        s["allow_suspend"] = self.suspend.get_active()
        s["hidden_chips"] = [r.fingerprint for r in self.chip_rows if hasattr(r, "fingerprint") and not r.get_active()]
        s["lock_when_gone"] = [r.fingerprint for r in self.leave_rows if hasattr(r, "fingerprint") and r.get_active()]
        self.settings = s
        call({"type": "set_settings", "settings": s}, None, self.win.error)


class StatusPage(Adw.Bin):
    def __init__(self, win):
        super().__init__()
        self.win = win
        self.page = Adw.PreferencesPage()
        self.group = Adw.PreferencesGroup(title="Status", description="What works on this PC, and how to fix what doesn't.")
        again = Gtk.Button(icon_name="view-refresh-symbolic", tooltip_text="Check again", valign=Gtk.Align.CENTER, css_classes=["flat"])
        again.connect("clicked", lambda _b: self.refresh())
        self.group.set_header_suffix(again)
        self.page.add(self.group)
        self.set_child(self.page)
        self.rows = []

    def refresh(self):
        call({"type": "get_status"}, self.show, self.win.error)

    def show(self, replies):
        st = first(replies, "status") or {}
        for r in self.rows:
            self.group.remove(r)
        self.rows = []
        for item in st.get("items", []):
            row = Adw.ActionRow(title=GLib.markup_escape_text(item["name"]), subtitle=GLib.markup_escape_text(item["detail"]))
            icon = Gtk.Image(icon_name="emblem-ok-symbolic" if item["ok"] else "dialog-warning-symbolic")
            icon.add_css_class("success" if item["ok"] else "warning")
            row.add_prefix(icon)
            self.group.add(row)
            self.rows.append(row)
        return False


# ── Window ───────────────────────────────────────────────────────────────


class Window(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Tunnelrat", default_width=760, default_height=640)
        self.toasts = Adw.ToastOverlay()
        view = Adw.ToolbarView()
        header = Adw.HeaderBar()
        self.stack = Adw.ViewStack()
        switcher = Adw.ViewSwitcher(stack=self.stack, policy=Adw.ViewSwitcherPolicy.WIDE)
        header.set_title_widget(switcher)
        view.add_top_bar(header)

        self.devices_page = DevicesPage(self)
        self.layout_page = LayoutPage(self)
        self.settings_page = SettingsPage(self)
        self.status_page = StatusPage(self)
        self.stack.add_titled_with_icon(self.devices_page, "devices", "Devices", "phone-symbolic")
        self.stack.add_titled_with_icon(self.layout_page, "layout", "Layout", "input-mouse-symbolic")
        self.stack.add_titled_with_icon(self.settings_page, "settings", "Settings", "emblem-system-symbolic")
        self.stack.add_titled_with_icon(self.status_page, "status", "Status", "dialog-information-symbolic")
        self.stack.connect("notify::visible-child-name", lambda *_: self.on_page())

        bottom = Adw.ViewSwitcherBar(stack=self.stack)
        view.add_bottom_bar(bottom)
        view.set_content(self.stack)
        self.toasts.set_child(view)
        self.set_content(self.toasts)

        # Narrow windows: tabs at the bottom.
        bp = Adw.Breakpoint.new(Adw.BreakpointCondition.parse("max-width: 560sp"))
        bp.add_setter(switcher, "visible", False)
        bp.add_setter(bottom, "reveal", True)
        self.add_breakpoint(bp)

        for name, handler in (("power", self.on_power), ("unpair", self.on_unpair)):
            a = Gio.SimpleAction.new(name, GLib.VariantType.new("s"))
            a.connect("activate", handler)
            self.add_action(a)

        self.last_error = None
        self.poll()
        GLib.timeout_add_seconds(POLL_SECONDS, self.poll)

    def poll(self):
        if self.get_visible():
            self.devices_page.refresh()
            GLib.timeout_add(300, self.on_page_data)
        return True

    def on_page_data(self):
        devices = self.devices_page.devices
        page = self.stack.get_visible_child_name()
        if page == "layout" and self.layout_page.drag_from is None:
            self.layout_page.refresh(devices)
        return False

    def on_page(self):
        devices = self.devices_page.devices
        page = self.stack.get_visible_child_name()
        if page == "layout":
            self.layout_page.refresh(devices)
        elif page == "settings":
            self.settings_page.refresh(devices)
        elif page == "status":
            self.status_page.refresh()

    def run(self, msg, note=None):
        if note:
            self.toast(note)
        call(msg, None, self.error)

    def on_power(self, _a, param):
        name, action = json.loads(param.get_string())
        self.run({"type": "for_device", "device": name, "message": {"type": "power", "action": action}}, f"{name}: {action.replace('_', ' ')}")

    def on_unpair(self, _a, param):
        name, fp = json.loads(param.get_string())
        dialog = Adw.AlertDialog(heading=f"Unpair {name}?", body="It's disconnected at once and has to pair again to connect.")
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("unpair", "Unpair")
        dialog.set_response_appearance("unpair", Adw.ResponseAppearance.DESTRUCTIVE)

        def chosen(_d, response):
            if response == "unpair":
                call({"type": "unpair", "selector": fp}, lambda _r: (self.toast(f"Unpaired {name}"), self.devices_page.refresh()), self.error)

        dialog.connect("response", chosen)
        dialog.present(self)

    def toast(self, text):
        self.toasts.add_toast(Adw.Toast(title=GLib.markup_escape_text(text), timeout=3))
        return False

    def error(self, text):
        # Polling repeats; show each distinct problem once.
        if text != self.last_error:
            self.last_error = text
            self.toast(text)
        return False


class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.DEFAULT_FLAGS)

    def do_activate(self):
        win = self.get_active_window() or Window(self)
        win.present()


# ── Reply window (from a phone notification's "Reply" button) ────────────


def reply_window(device, key, title):
    """`tunnelrat-app --reply --device FP --key KEY --title T`: one small window
    that sends a reply through the phone notification's own reply field."""
    app = Adw.Application(application_id=None, flags=Gio.ApplicationFlags.NON_UNIQUE)

    def activate(a):
        win = Adw.ApplicationWindow(application=a, title="Reply", default_width=460)
        view = Adw.ToolbarView()
        view.add_top_bar(Adw.HeaderBar())
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin_start=18, margin_end=18, margin_bottom=18)
        box.append(Gtk.Label(label=title, wrap=True, xalign=0, css_classes=["heading"]))
        row = Gtk.Box(spacing=8)
        entry = Gtk.Entry(placeholder_text="Your reply", hexpand=True)
        send = Gtk.Button(label="Send", css_classes=["suggested-action"])
        row.append(entry)
        row.append(send)
        box.append(row)
        status = Gtk.Label(wrap=True, xalign=0, css_classes=["dim-label"])
        box.append(status)
        view.set_content(box)
        win.set_content(view)

        def sent(_replies):
            win.close()
            return False

        def failed(err):
            status.set_label(f"Not sent: {err}")
            send.set_sensitive(True)
            entry.set_sensitive(True)
            return False

        def go(*_):
            text = entry.get_text().strip()
            if not text:
                return
            send.set_sensitive(False)
            entry.set_sensitive(False)
            status.set_label("Sending…")
            msg = {"type": "for_device", "device": device, "message": {"type": "phone_reply", "key": key, "text": text}}
            call(msg, sent, failed)

        entry.connect("activate", go)
        send.connect("clicked", go)
        win.present()
        entry.grab_focus()

    app.connect("activate", activate)
    app.run([])


if __name__ == "__main__":
    import argparse
    import sys

    if "--reply" in sys.argv:
        ap = argparse.ArgumentParser()
        ap.add_argument("--reply", action="store_true")
        ap.add_argument("--device", required=True)
        ap.add_argument("--key", required=True)
        ap.add_argument("--title", default="Reply")
        args = ap.parse_args()
        reply_window(args.device, args.key, args.title)
    else:
        App().run(None)
