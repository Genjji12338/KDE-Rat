"""Shows a phone's or PC's screen (H.264) in a window and passes mouse and
keyboard input back: as touch gestures for a phone (--mode phone), as
pointer, button, wheel and key events for a PC (--mode pc).

turad starts this and talks to it over pipes:
  stdin:  frames, each a 4-byte big-endian length + one H.264 access unit
  stdout: JSON lines, tura-proto messages to forward to the phone
          (phone_gesture, phone_nav, phone_text)
The window closing (or stdin ending) ends the mirroring.

Phone: left button = touch (tap, hold, swipe, drag), right = Back,
middle = Home, wheel = swipe. Keyboard: typing goes to the focused field,
Esc = Back.
PC: the mouse and keyboard act on the other PC as if plugged into it (its
pointer is drawn in the picture, so the local one is hidden over it).
"""

import argparse
import json
import os
import struct
import sys
import threading
import time

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
gi.require_version("Gst", "1.0")
from gi.repository import Gdk, GLib, Gst, Gtk  # noqa: E402

# Wheel: fraction of the screen height one notch swipes.
SCROLL_STEP = 0.12
SCROLL_FLUSH_MS = 90


def send(msg):
    try:
        sys.stdout.write(json.dumps(msg) + "\n")
        sys.stdout.flush()
    except BrokenPipeError:
        os._exit(0)  # turad is gone


class Viewer(Gtk.Application):
    def __init__(self, args):
        super().__init__(application_id=None)
        self.args = args
        self.vw, self.vh = max(args.width, 1), max(args.height, 1)
        self.pc = args.mode == "pc"
        Gst.init(None)
        # Software decoding: a phone-sized stream is cheap, and the VA-API
        # decoder won't take unparsed byte-stream caps without h264parse.
        decoder = "avdec_h264" if Gst.ElementFactory.find("avdec_h264") else "openh264dec"
        self.pipeline = Gst.parse_launch(
            "appsrc name=src is-live=true format=time do-timestamp=true "
            "caps=video/x-h264,stream-format=byte-stream,alignment=au "
            # Convert to RGB here, honouring the stream's colour range; left to
            # the sink, limited-range video showed washed out.
            f"! {decoder} ! videoconvert ! video/x-raw,format=BGRA ! gtk4paintablesink name=sink sync=false"
        )
        self.src = self.pipeline.get_by_name("src")
        self.sink = self.pipeline.get_by_name("sink")
        self.start = (0.0, 0.0)
        self.last_move = 0.0
        self.pointer = (0.5, 0.5)
        self.scroll_acc = 0.0
        self.scroll_timer = 0

    # ── video ──

    def read_frames(self):
        inp = sys.stdin.buffer
        while True:
            head = inp.read(4)
            if len(head) < 4:
                break
            (n,) = struct.unpack(">I", head)
            data = inp.read(n)
            if len(data) < n:
                break
            self.src.emit("push-buffer", Gst.Buffer.new_wrapped(data))
        GLib.idle_add(self.quit)

    # ── window ──

    def do_activate(self):
        win = Gtk.ApplicationWindow(application=self, title=self.args.title)
        self.win = win
        win.set_default_size(*self.window_size())

        paintable = self.sink.get_property("paintable")
        paintable.connect("invalidate-size", self.on_video_size)
        self.picture = Gtk.Picture(paintable=paintable)
        self.picture.set_content_fit(Gtk.ContentFit.CONTAIN)
        self.picture.set_can_shrink(True)
        self.picture.set_vexpand(True)
        self.picture.set_cursor(Gdk.Cursor.new_from_name("none" if self.pc else "default"))
        if self.pc:
            self.picture.set_focusable(True)
            self.setup_pc_input(win)
            win.set_child(self.picture)
            win.connect("close-request", lambda _w: self.quit() or False)
            win.present()
            self.pipeline.set_state(Gst.State.PLAYING)
            threading.Thread(target=self.read_frames, daemon=True).start()
            return

        bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6, homogeneous=True)
        bar.set_margin_start(8)
        bar.set_margin_end(8)
        bar.set_margin_top(6)
        bar.set_margin_bottom(6)
        for icon, tip, action in (
            ("go-previous-symbolic", "Back (right click, Esc)", "back"),
            ("go-home-symbolic", "Home (middle click)", "home"),
            ("view-app-grid-symbolic", "Recent apps", "recents"),
            ("preferences-system-notifications-symbolic", "Notifications", "notifications"),
        ):
            b = Gtk.Button(icon_name=icon, tooltip_text=tip)
            b.add_css_class("flat")
            b.connect("clicked", lambda _b, a=action: send({"type": "phone_nav", "action": a}))
            bar.append(b)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        box.append(self.picture)
        box.append(bar)
        win.set_child(box)

        drag = Gtk.GestureDrag(button=Gdk.BUTTON_PRIMARY)
        drag.connect("drag-begin", self.on_begin)
        drag.connect("drag-update", self.on_update)
        drag.connect("drag-end", self.on_end)
        self.picture.add_controller(drag)

        other = Gtk.GestureClick(button=0)
        other.connect("pressed", self.on_other_button)
        self.picture.add_controller(other)

        motion = Gtk.EventControllerMotion()
        motion.connect("motion", lambda _c, x, y: setattr(self, "pointer", self.norm(x, y)))
        self.picture.add_controller(motion)

        scroll = Gtk.EventControllerScroll(flags=Gtk.EventControllerScrollFlags.VERTICAL)
        scroll.connect("scroll", self.on_scroll)
        self.picture.add_controller(scroll)

        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", self.on_key)
        win.add_controller(keys)

        win.connect("close-request", lambda _w: self.quit() or False)
        win.present()
        self.pipeline.set_state(Gst.State.PLAYING)
        threading.Thread(target=self.read_frames, daemon=True).start()

    # ── PC mode: the mouse and keyboard act on the other PC ──

    def setup_pc_input(self, win):
        self.last_move = 0.0
        self.held_keys = set()
        motion = Gtk.EventControllerMotion()
        motion.connect("motion", self.pc_motion)
        self.picture.add_controller(motion)
        click = Gtk.GestureClick(button=0)
        click.connect("pressed", lambda g, _n, x, y: self.pc_button(g, x, y, "down"))
        click.connect("released", lambda g, _n, x, y: self.pc_button(g, x, y, "up"))
        self.picture.add_controller(click)
        scroll = Gtk.EventControllerScroll(flags=Gtk.EventControllerScrollFlags.BOTH_AXES)
        scroll.connect("scroll", lambda _c, dx, dy: send({"type": "scroll", "dx": dx, "dy": dy}) or True)
        self.picture.add_controller(scroll)
        keys = Gtk.EventControllerKey()
        keys.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)  # before GTK's own shortcuts
        keys.connect("key-pressed", self.pc_key_down)
        keys.connect("key-released", self.pc_key_up)
        win.add_controller(keys)
        # Leaving the window: let go of everything, or keys stay stuck over there.
        win.connect("notify::is-active", lambda w, _p: None if w.is_active() else self.release_all())

    def pc_motion(self, _c, x, y):
        now = time.monotonic()
        if now - self.last_move >= 0.008:
            self.last_move = now
            nx, ny = self.norm(x, y)
            send({"type": "pointer_abs", "x": nx, "y": ny})

    def pc_button(self, gesture, x, y, state):
        b = {Gdk.BUTTON_PRIMARY: "left", Gdk.BUTTON_SECONDARY: "right", Gdk.BUTTON_MIDDLE: "middle"}.get(gesture.get_current_button())
        if not b:
            return
        self.picture.grab_focus()
        nx, ny = self.norm(x, y)
        send({"type": "pointer_abs", "x": nx, "y": ny})
        send({"type": "pointer_button", "button": b, "state": state})

    def pc_key_down(self, _c, _keyval, keycode, _state):
        code = keycode - 8  # XKB keycode → Linux evdev code
        if code > 0:
            self.held_keys.add(code)
            send({"type": "key", "code": code, "state": "down"})
        return True

    def pc_key_up(self, _c, _keyval, keycode, _state):
        code = keycode - 8
        if code > 0:
            self.held_keys.discard(code)
            send({"type": "key", "code": code, "state": "up"})

    def release_all(self):
        for code in list(self.held_keys):
            send({"type": "key", "code": code, "state": "up"})
        self.held_keys.clear()

    def video_size(self):
        """The decoded picture's size (follows the phone's rotation)."""
        p = self.picture.get_paintable()
        w, h = (p.get_intrinsic_width(), p.get_intrinsic_height()) if p else (0, 0)
        return (w, h) if w > 0 and h > 0 else (self.vw, self.vh)

    def on_video_size(self, _paintable):
        w, h = self.video_size()
        if (w > h) != (self.vw > self.vh):
            # Rotated: give the window the new shape (same height budget).
            self.vw, self.vh = w, h
            self.win.set_default_size(*self.window_size())
        self.vw, self.vh = w, h

    def window_size(self):
        if self.pc:
            w = 1280
            return w, int(w * self.vh / self.vw)
        h = 860 if self.vh >= self.vw else 600
        return int(h * self.vw / self.vh), h + 52

    def norm(self, x, y):
        """Widget coordinates → 0–1 on the phone screen (the picture is letterboxed)."""
        vw, vh = self.video_size()
        w, h = self.picture.get_width(), self.picture.get_height()
        s = min(w / vw, h / vh) or 1
        dw, dh = vw * s, vh * s
        ox, oy = (w - dw) / 2, (h - dh) / 2
        return (min(max((x - ox) / dw, 0.0), 1.0), min(max((y - oy) / dh, 0.0), 1.0))

    # ── touch from the left button: live, so drags follow the mouse ──

    def touch(self, action, x, y):
        nx, ny = self.norm(x, y)
        send({"type": "phone_touch", "action": action, "x": nx, "y": ny})

    def on_begin(self, _g, x, y):
        self.start = (x, y)
        self.last_move = 0.0
        self.touch("down", x, y)

    def on_update(self, _g, dx, dy):
        now = time.monotonic()
        if now - self.last_move >= 0.012:  # ~80 updates/s is plenty
            self.last_move = now
            self.touch("move", self.start[0] + dx, self.start[1] + dy)

    def on_end(self, _g, dx, dy):
        self.touch("up", self.start[0] + dx, self.start[1] + dy)

    def on_other_button(self, g, _n, _x, _y):
        b = g.get_current_button()
        if b == Gdk.BUTTON_SECONDARY:
            send({"type": "phone_nav", "action": "back"})
        elif b == Gdk.BUTTON_MIDDLE:
            send({"type": "phone_nav", "action": "home"})

    # ── wheel → swipe ──

    def on_scroll(self, _c, _dx, dy):
        self.scroll_acc += dy
        if not self.scroll_timer:
            self.scroll_timer = GLib.timeout_add(SCROLL_FLUSH_MS, self.flush_scroll)
        return True

    def flush_scroll(self):
        self.scroll_timer = 0
        amount, self.scroll_acc = self.scroll_acc, 0.0
        if amount:
            x, y = self.pointer
            # Wheel down = content moves up = finger swipes up.
            dist = max(min(amount * SCROLL_STEP, 0.6), -0.6)
            y2 = min(max(y - dist, 0.0), 1.0)
            send({"type": "phone_gesture", "path": [[x, y, 0.0], [x, y2, 160.0]]})
        return False

    # ── keyboard → typing ──

    def on_key(self, _c, keyval, _code, state):
        if state & (Gdk.ModifierType.CONTROL_MASK | Gdk.ModifierType.ALT_MASK | Gdk.ModifierType.SUPER_MASK):
            return False
        if keyval == Gdk.KEY_Escape:
            send({"type": "phone_nav", "action": "back"})
        elif keyval == Gdk.KEY_BackSpace:
            send({"type": "phone_text", "text": "\b"})
        elif keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            send({"type": "phone_text", "text": "\n"})
        else:
            ch = Gdk.keyval_to_unicode(keyval)
            if ch < 32:
                return False
            send({"type": "phone_text", "text": chr(ch)})
        return True


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("--title", default="Phone")
    ap.add_argument("--width", type=int, default=1080)
    ap.add_argument("--height", type=int, default=2400)
    ap.add_argument("--mode", choices=("phone", "pc"), default="phone")
    args = ap.parse_args()
    Viewer(args).run([])
    # The stdin reader thread may still be blocked in read(): don't wait for it.
    sys.stdout.flush()
    os._exit(0)


if __name__ == "__main__":
    main()
