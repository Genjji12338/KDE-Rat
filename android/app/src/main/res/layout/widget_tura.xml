<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="vertical" android:padding="12dp">

    <TextView android:id="@+id/widget_title"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:drawableStart="@drawable/ic_tunnelrat" android:drawablePadding="8dp" android:drawableTint="#FFB224"
        android:gravity="center_vertical" android:paddingBottom="8dp"
        android:text="Tunnelrat" android:textColor="#F4EFE6" android:textSize="15sp" android:textStyle="bold"
        android:maxLines="1" android:ellipsize="end" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal">
        <TextView android:id="@+id/widget_wake"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginEnd="6dp" android:background="@drawable/widget_btn_wake"
            android:drawableTop="@drawable/ic_wake" android:drawableTint="#0B0B0A" android:paddingTop="10dp"
            android:gravity="center" android:text="Wake" android:textColor="#0B0B0A" android:textStyle="bold" />
        <TextView android:id="@+id/widget_off"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="6dp" android:background="@drawable/widget_btn_off"
            android:drawableTop="@drawable/ic_power" android:drawableTint="#FF5A4E" android:paddingTop="10dp"
            android:gravity="center" android:text="Off" android:textColor="#FF5A4E" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
